{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yolk-yard",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "CLIENT_ORIGINS": "https://zl-2.github.io" },
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [{"name": "YOLK", "class_name": "YolkService"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["YolkService"]}]
}
